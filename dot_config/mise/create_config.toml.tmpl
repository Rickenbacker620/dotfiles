[tools]
eza = "latest"
dust = "latest"
fd = "latest"
bottom = "latest"
bat = "latest"
ripgrep = "latest"
zoxide = "latest"
fzf = "latest"
duf = "latest"
zellij = "latest"
{{- if eq .chezmoi.os "linux" }}
"aqua:fish-shell/fish-shell" = "latest"
# The prebuilt gnu yazi needs GLIBC_2.39; the musl build is static and runs
# on older distros too. aqua ignores `matching`, hence the github backend.
"github:sxyazi/yazi" = { version = "latest", matching = "musl" }
{{- else }}
yazi = "latest"
{{- end }}
neovim = "latest"
jq = "latest"
gum = "latest"
starship = "latest"

[settings]
not_found_auto_install = false
not_found_system_fallback = false

[env]
_.file = '~/.config/mise/.env'
