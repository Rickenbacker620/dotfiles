{{- if eq .chezmoi.os "windows" -}}
{{- else -}}
#!/bin/bash
{{- $osConfig := index . .osid }}
{{- $pm := $osConfig.packageManager }}
{{- $packages := $osConfig.packages }}

echo "Updating package manager..."
{{ $pm.update }}

echo "Installing essential packages ({{ .osid }})..."
{{ $pm.install }} git curl wget fish \
{{- range $packages.essential }}
  {{ . }} \
{{- end }}

{{ if and (ne .osid "linux-arch") (ne .osid "darwin") -}}
echo "Installing mise"

curl https://mise.run | sh
{{ end -}}

{{ if eq .hosttype "desktop" -}}

echo "Installing desktop packages ({{ .osid }})..."
{{-   if hasKey $pm "installCask" }}
{{ $pm.installCask }} \
{{-   else }}
{{ $pm.install }} \
{{-   end }}
{{- range $packages.desktop }}
  {{ . }} \
{{- end }}

{{ end -}}

echo "All packages installed successfully!"
{{- end -}}