#!/bin/sh
# Shared logic for the `play` shell function (fish/bash/zsh).
# The calling shell function is responsible for `cd`-ing, since a child
# process cannot change its parent shell's working directory. This script
# reports the final project path via --cwd-file, mirroring the pattern the
# `f` (yazi) function uses for the same reason.

cwd_file=""
if [ "${1:-}" = "--cwd-file" ]; then
	cwd_file=$2
	shift 2
fi

report_cwd() {
	[ -n "$cwd_file" ] && printf '%s' "$project_path" > "$cwd_file"
}

open_code() {
	if command -v code >/dev/null 2>&1; then
		(cd "$project_path" && code .)
	else
		echo "Error: VS Code 'code' command not found"
		echo "Make sure VS Code is installed and the 'code' command is in your PATH"
	fi
}

if ! command -v gum >/dev/null 2>&1; then
	echo "Error: gum is not installed. Install it from: https://github.com/charmbracelet/gum" >&2
	exit 1
fi

if [ -z "${PLAYGROUND_DIR:-}" ]; then
	echo "Error: PLAYGROUND_DIR environment variable is not set" >&2
	echo "Set it in your shell config: export PLAYGROUND_DIR=/path/to/playground" >&2
	exit 1
fi

clone_url=""

if [ $# -ge 1 ]; then
	input=$1
	case "$input" in
		https://*|http://*|git@*)
			clone_url=$input
			name=${clone_url%.git}
			name=${name##*/}
			if ! gum confirm "Clone '$clone_url' as '$name'?"; then
				echo "Cancelled"
				exit 1
			fi
			;;
		*)
			name=$input
			if ! gum confirm "Create project '$name'?"; then
				echo "Cancelled"
				exit 1
			fi
			;;
	esac
else
	name=$(gum input --placeholder "What's the project name?")
	if [ -z "$name" ]; then
		echo "Cancelled: No project name provided"
		exit 1
	fi
fi

project_path="$PLAYGROUND_DIR/$name"

if [ -d "$project_path" ]; then
	gum style --foreground 214 --border double --padding "1 2" \
		"⚠ Project already exists!" \
		"" \
		"Location: $project_path"

	if gum confirm "Open existing project in VS Code?"; then
		open_code
	fi
	report_cwd
	exit 0
fi

if [ -n "$clone_url" ]; then
	if ! git clone -- "$clone_url" "$project_path"; then
		echo "Error: Failed to clone repository" >&2
		exit 1
	fi
	success_message="✓ Repository cloned successfully!"
else
	if ! mkdir -p "$project_path"; then
		echo "Error: Failed to create directory at $project_path" >&2
		exit 1
	fi
	success_message="✓ Project created successfully!"
fi

gum style --foreground 212 --border double --padding "1 2" \
	"$success_message" \
	"" \
	"Location: $project_path"

report_cwd

if gum confirm "Open in VS Code?"; then
	open_code
fi
