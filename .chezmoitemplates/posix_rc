# If not running interactively, don't do anything
case $- in
	*i*) ;;
	*) return ;;
esac

# Persistent history
HISTDIR="${XDG_STATE_HOME:-$HOME/.local/state}/{{ . }}"
mkdir -p "$HISTDIR"
HISTFILE="$HISTDIR/history"
HISTSIZE=10000
{{ if eq . "zsh" -}}
SAVEHIST=10000
setopt APPEND_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_ALL_DUPS
{{- else -}}
HISTFILESIZE=10000
HISTCONTROL=ignoredups:ignorespace
shopt -s histappend
{{- end }}

function f() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

play() {
	local tmp rc cwd
	tmp="$(mktemp -t "play-cwd.XXXXXX")"
	play-engine --cwd-file "$tmp" "$@"
	rc=$?
	if [ -s "$tmp" ]; then
		cwd="$(cat "$tmp")"
		[ -d "$cwd" ] && cd -- "$cwd"
	fi
	rm -f -- "$tmp"
	return $rc
}

{{ template "shell_alias" . }}

eval "$(~/.local/bin/mise activate {{ . }})"
eval "$(zoxide init {{ . }})"
eval "$(starship init {{ . }})"
