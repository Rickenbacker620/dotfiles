case $- in
	*i*) ;;
	*) return ;;
esac

unset HISTFILE

# Hand off to fish, but only in a real terminal session. Tools that snapshot the
# environment run `sh -i -c '...'`, which is "interactive" but would be replaced
# mid-flight by the exec below, so they never see the PATH this rc file sets up.
if [ -z "$SHELL_HANDOFF" ] &&
	[ -z "$BASH_EXECUTION_STRING$ZSH_EXECUTION_STRING" ] &&
	[ -t 1 ]; then
	fish_bin=$(command -v fish 2>/dev/null) ||
		fish_bin=$("$HOME/.local/bin/mise" which fish 2>/dev/null)
	[ -n "$fish_bin" ] && export SHELL_HANDOFF=1 && exec "$fish_bin"
	unset fish_bin
fi
