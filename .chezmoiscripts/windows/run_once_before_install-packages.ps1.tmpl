{{- if eq .chezmoi.os "windows" -}}
{{- $osConfig := index . .osid -}}
{{- $pm := $osConfig.packageManager -}}
{{- $packages := $osConfig.packages -}}
$ErrorActionPreference = "Stop"

function Invoke-Checked {
    param([Parameter(Mandatory)][string]$CommandLine)
    Write-Host $CommandLine
    Invoke-Expression $CommandLine
    # winget returns 0x8A15002B (no applicable update) when the package is
    # already installed and up to date; that's not a real failure.
    if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne -1978335189) {
        throw "Command failed with exit code ${LASTEXITCODE}: $CommandLine"
    }
}

Write-Host "Installing essential packages ({{ .osid }})..."
{{- range $packages.essential }}
Invoke-Checked '{{ $pm.install }} {{ . }}'
{{- end }}

{{ if .hasDesktop -}}
Write-Host "Installing desktop packages ({{ .osid }})..."
{{- range $packages.desktop }}
Invoke-Checked '{{ $pm.install }} {{ . }}'
{{- end }}
{{ end -}}

Write-Host "All packages installed successfully!"
{{- end -}}
